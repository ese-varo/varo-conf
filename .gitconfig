[alias]
  a  = add
  cm = commit -m
  s  = status
  p  = push
	co = checkout
  fp = fetch --prune --all
  l  = log --online --decorate --graph
	br = branch
[core]
	editor = nvim
[github]
  user = ese-varo
[user]
	email = varoboss.ap@gmail.com
	name = Alvaro Padilla
[init]
	defaultBranch = main
[push]
  autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
